{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeia.dev/schemas/c4.schema.json",
  "title": "C4 Model Structured Data",
  "description": "Contract for product/technical/architecture/c4/{system,containers,components,dataflow,entities,statemachine}.json \u2014 the machine-readable architecture surface used for product feasibility review and operations scoping.",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "system",
        "container",
        "component",
        "dataflow",
        "entity",
        "statemachine"
      ],
      "description": "Which level of the C4 (or adjacent) zoom this file describes."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this file was produced."
    },
    "skill": {
      "type": "string",
      "description": "The skill that produced this file."
    },
    "skill_version": {
      "type": "string",
      "description": "Skill version for traceability of regenerated content."
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "technology": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "target",
                "description"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "level",
    "elements"
  ],
  "additionalProperties": true,
  "archeia": {
    "shape": "living",
    "domain": "product",
    "subdir": "technical/architecture/c4",
    "contract": "technical architecture -> product/operations",
    "evidence_principle": "Every element's evidence array must cite at least one file path in the source tree. Elements without evidence must be flagged or omitted."
  }
}
